<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tracker IFC — Suivi des composants</title>
    <link rel="stylesheet" href="/static/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        .tracker-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem; }
        .tracker-title { font-size:1.5rem; font-weight:700; color:#1e3a5f; display:flex; align-items:center; gap:.5rem; }
        .stats-row { display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:1.5rem; }
        .stat-chip { background:white; border:1px solid #e5e7eb; border-radius:8px; padding:.6rem 1.2rem; font-size:.9rem; font-weight:600; color:#374151; box-shadow:0 1px 3px rgba(0,0,0,.06); }
        .stat-chip span { color:#2563eb; }
        .filters-row { display:flex; gap:.75rem; flex-wrap:wrap; margin-bottom:1rem; align-items:center; }
        .filter-select { padding:.45rem .75rem; border:1px solid #d1d5db; border-radius:6px; font-size:.9rem; background:#f9fafb; outline:none; }
        .import-btn { background:#2563eb; color:white; border:none; padding:.5rem 1.1rem; border-radius:6px; cursor:pointer; font-size:.9rem; font-weight:600; display:flex; align-items:center; gap:.4rem; }
        .import-btn:hover { background:#1d4ed8; }
        .comp-table { width:100%; border-collapse:collapse; background:white; border-radius:10px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,.08); }
        .comp-table th { background:#1e3a5f; color:white; padding:10px 12px; font-size:.85rem; text-align:left; }
        .comp-table td { padding:9px 12px; font-size:.85rem; color:#374151; border-bottom:1px solid #f3f4f6; }
        .comp-table tr:hover td { background:#f0f4ff; cursor:pointer; }
        .badge { display:inline-block; padding:2px 10px; border-radius:20px; font-size:.75rem; font-weight:600; }
        .badge-in_building { background:#dbeafe; color:#1e40af; }
        .badge-démonté    { background:#fef3c7; color:#92400e; }
        .badge-transporté { background:#e0e7ff; color:#3730a3; }
        .badge-stocké     { background:#fce7f3; color:#9d174d; }
        .badge-réutilisé  { background:#d1fae5; color:#065f46; }
        .empty-msg { text-align:center; padding:3rem; color:#9ca3af; font-size:.95rem; }
        .import-info { font-size:.8rem; color:#6b7280; margin-top:.3rem; }
    </style>
</head>
<body>
<header class="header">
    <div class="header-content">
        <div class="logo"><i data-lucide="scan-line"></i> IFC Analyzer</div>
        <nav style="display:flex;gap:1rem;align-items:center;">
            <a href="/" style="color:#93c5fd;text-decoration:none;font-size:.9rem;">← Retour à l'analyseur</a>
            <a href="/viewer3d" style="background:#7c3aed;color:white;padding:.4rem .9rem;border-radius:6px;text-decoration:none;font-size:.85rem;font-weight:600;display:flex;align-items:center;gap:.4rem;">
                <i data-lucide="box" style="width:14px;height:14px;"></i> Viewer 3D
            </a>
        </nav>
    </div>
</header>

<main style="max-width:1100px;margin:2rem auto;padding:0 1.5rem;">
    <div class="tracker-header">
        <div class="tracker-title"><i data-lucide="map-pin"></i> Suivi des composants IFC</div>
        <div style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;">
            <label style="font-size:.85rem;color:#374151;display:flex;align-items:center;gap:.4rem;">
                <i data-lucide="folder" style="width:16px;height:16px;"></i> Projet :
                <select class="filter-select" id="projectSelect" onchange="onProjectChange()" style="min-width:220px;">
                    <option value="">Chargement...</option>
                </select>
            </label>
            <button class="import-btn" onclick="openImportModal()">
                <i data-lucide="upload"></i> Nouveau projet
            </button>
            <button id="exportIfcBtn" onclick="exportProjectIfc()"
                style="background:#059669;color:white;border:none;padding:.5rem 1rem;border-radius:6px;cursor:pointer;font-size:.9rem;font-weight:600;display:flex;align-items:center;gap:.4rem;">
                <i data-lucide="file-down" style="width:16px;height:16px;"></i> <span id="exportIfcLabel">Exporter en IFC</span>
            </button>
            <input type="file" id="projectIfcInput" accept=".ifc" style="display:none;">
            <button id="exportReuseCsvBtn" onclick="openCsvPicker(event)"
                title="Générer un CSV (PEM ou Déchets inertes)"
                style="background:#7c3aed;color:white;border:none;padding:.5rem 1rem;border-radius:6px;cursor:pointer;font-size:.9rem;font-weight:600;display:flex;align-items:center;gap:.4rem;">
                <i data-lucide="file-spreadsheet" style="width:16px;height:16px;"></i> CSV réemploi
                <i data-lucide="chevron-down" style="width:14px;height:14px;"></i>
            </button>
            <button id="deleteProjectBtn" onclick="deleteCurrentProject()"
                style="background:#dc2626;color:white;border:none;padding:.5rem 1rem;border-radius:6px;cursor:pointer;font-size:.9rem;font-weight:600;display:flex;align-items:center;gap:.4rem;">
                <i data-lucide="trash-2" style="width:16px;height:16px;"></i> Supprimer
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div class="stats-row" id="statsRow">
        <div class="stat-chip">Chargement...</div>
    </div>

    <!-- Filtres -->
    <div class="filters-row">
        <select class="filter-select" id="filterStatus" onchange="loadComponents()">
            <option value="">Tous les statuts</option>
            <option value="in_building">In building</option>
            <option value="démonté">Démonté</option>
            <option value="transporté">Transporté</option>
            <option value="stocké">Stocké</option>
            <option value="réutilisé">Réutilisé</option>
        </select>
        <select class="filter-select" id="filterType" onchange="loadComponents()">
            <option value="">Tous les types</option>
        </select>
        <span id="countLabel" style="font-size:.85rem;color:#6b7280;margin-left:.5rem;"></span>
    </div>

    <!-- Tableau -->
    <table class="comp-table" id="compTable">
        <thead>
            <tr>
                <th style="width:36px;text-align:center;">
                    <input type="checkbox" id="selectAllChk" onclick="toggleSelectAll(this)" title="Tout sélectionner">
                </th>
                <th>ID</th><th>Type</th><th>Matériau</th>
                <th>Emplacement IFC</th><th>Statut</th><th>Mis à jour</th>
            </tr>
        </thead>
        <tbody id="compBody"><tr><td colspan="7" class="empty-msg">Chargement...</td></tr></tbody>
    </table>
</main>

<!-- Barre d'action bulk (apparaît quand >= 1 sélectionné) -->
<div id="bulkBar" style="display:none;position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#1e3a5f;color:white;padding:.8rem 1.2rem;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.25);z-index:900;align-items:center;gap:.8rem;flex-wrap:wrap;max-width:95vw;">
    <span style="font-weight:600;font-size:.92rem;"><span id="bulkCount">0</span> sélectionné(s)</span>
    <span style="color:#94a3b8;">→ Changer le statut :</span>
    <button class="bulk-btn" onclick="bulkSetStatus('in_building')"  style="background:#1e40af;">🏗️ In building</button>
    <button class="bulk-btn" onclick="bulkSetStatus('démonté')"      style="background:#92400e;">🔨 Démonté</button>
    <button class="bulk-btn" onclick="bulkSetStatus('transporté')"   style="background:#3730a3;">🚚 Transporté</button>
    <button class="bulk-btn" onclick="bulkSetStatus('stocké')"       style="background:#9d174d;">📦 Stocké</button>
    <button class="bulk-btn" onclick="bulkSetStatus('à réutiliser')" style="background:#059669;">♻️ À réutiliser</button>
    <button class="bulk-btn" onclick="bulkSetStatus('réutilisé')"    style="background:#065f46;">✅ Réutilisé</button>
    <button class="bulk-btn" onclick="bulkSetStatus('à recycler')"   style="background:#14532d;">🔄 À recycler</button>
    <span style="border-left:1px solid #475569;height:24px;margin:0 .2rem;"></span>
    <button class="bulk-btn" onclick="openBulkMetaModal()" style="background:#7c3aed;">📋 État &amp; informations</button>
    <button onclick="clearSelection()" style="background:#374151;color:white;border:none;padding:.45rem .8rem;border-radius:6px;cursor:pointer;font-size:.85rem;font-weight:600;">Annuler</button>
</div>
<style>
.bulk-btn { color:white; border:none; padding:.45rem .75rem; border-radius:6px; cursor:pointer; font-size:.82rem; font-weight:600; white-space:nowrap; }
.bulk-btn:hover { filter: brightness(1.15); }
.row-chk { cursor: pointer; width:16px; height:16px; }
tr.selected-row { background:#eff6ff !important; }
</style>

<!-- Modal import -->
<div id="importModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:12px;padding:2rem;width:520px;max-width:95vw;">
        <h3 style="margin:0 0 .5rem;color:#1e3a5f;">Créer un nouveau projet</h3>
        <p style="font-size:.9rem;color:#6b7280;margin-bottom:1rem;">
            Chaque import crée un projet indépendant. Donnez-lui un nom (ex : nom du bâtiment) puis collez le JSON exporté depuis l'analyseur.
        </p>
        <label style="display:block;font-size:.82rem;color:#374151;font-weight:600;margin-bottom:.3rem;">Nom du projet</label>
        <input id="projectNameInput" type="text" placeholder="Ex : Réhabilitation École Jules Ferry"
               style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:.5rem .7rem;font-size:.9rem;margin-bottom:1rem;">
        <label style="display:block;font-size:.82rem;color:#374151;font-weight:600;margin-bottom:.3rem;">JSON des composants</label>
        <textarea id="jsonPaste" rows="7" style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:.5rem;font-size:.8rem;font-family:monospace;resize:vertical;" placeholder='[{"id":"...","type":"Porte","material":"Bois",...}]'></textarea>
        <p class="import-info" id="importInfo"></p>
        <div style="display:flex;justify-content:flex-end;gap:.75rem;margin-top:1rem;">
            <button onclick="closeImportModal()" style="background:#f3f4f6;border:1px solid #d1d5db;padding:.5rem 1.2rem;border-radius:6px;cursor:pointer;">Annuler</button>
            <button onclick="doImport()" class="import-btn">Créer le projet</button>
        </div>
    </div>
</div>

<footer class="footer"><p>IFC Analyzer — Tracker © 2025</p></footer>

<script>
lucide.createIcons();

const LS_PROJECT_KEY = "ifc_analyzer:tracker_project_id";
let currentProjectId = null;

function setCurrentProjectId(id) {
    currentProjectId = id ? Number(id) : null;
    if (currentProjectId) {
        localStorage.setItem(LS_PROJECT_KEY, String(currentProjectId));
    } else {
        localStorage.removeItem(LS_PROJECT_KEY);
    }
}

function projectQuery() {
    return currentProjectId ? `project_id=${currentProjectId}` : "";
}

async function loadProjects() {
    const res = await fetch("/api/tracker/projects");
    const projects = await res.json();
    const sel = document.getElementById("projectSelect");

    if (!projects.length) {
        sel.innerHTML = '<option value="">Aucun projet — cliquez sur "Nouveau projet"</option>';
        currentProjectId = null;
        return;
    }

    // Sélection persistée ou premier projet par défaut
    const saved = Number(localStorage.getItem(LS_PROJECT_KEY));
    const exists = projects.find(p => p.id === saved);
    if (exists) {
        currentProjectId = saved;
    } else {
        currentProjectId = projects[0].id;
        setCurrentProjectId(currentProjectId);
    }

    sel.innerHTML = projects.map(p => {
        const date = (p.created_at || "").slice(0, 10);
        return `<option value="${p.id}" ${p.id===currentProjectId?'selected':''}>${p.name} — ${p.component_count} comp. (${date})</option>`;
    }).join("");
}

// ============ EXPORT IFC ENRICHI ============
async function refreshExportIfcLabel() {
    const labelEl = document.getElementById("exportIfcLabel");
    if (!currentProjectId) { labelEl.textContent = "Exporter en IFC"; return; }
    try {
        const r = await fetch(`/api/tracker/projects/${currentProjectId}/ifc-info`);
        if (!r.ok) { labelEl.textContent = "Exporter en IFC"; return; }
        const info = await r.json();
        labelEl.textContent = info.has_ifc ? "Exporter en IFC" : "Lier IFC + Exporter";
    } catch { labelEl.textContent = "Exporter en IFC"; }
}

async function exportProjectIfc() {
    if (!currentProjectId) { alert("Aucun projet sélectionné."); return; }
    // Vérifier si un IFC est déjà associé
    const infoRes = await fetch(`/api/tracker/projects/${currentProjectId}/ifc-info`);
    const info = await infoRes.json();
    if (!info.has_ifc) {
        // Demander l'upload une fois
        alert("Première utilisation : sélectionnez le fichier IFC d'origine de ce projet.\nIl sera mémorisé pour les exports futurs.");
        document.getElementById("projectIfcInput").click();
        return;
    }
    await downloadEnrichedIfc();
}

document.getElementById("projectIfcInput").addEventListener("change", async (e) => {
    const file = e.target.files[0];
    e.target.value = "";
    if (!file || !currentProjectId) return;
    const btn = document.getElementById("exportIfcBtn");
    const lbl = document.getElementById("exportIfcLabel");
    const origLbl = lbl.textContent;
    btn.disabled = true; lbl.textContent = "Upload en cours…";
    const fd = new FormData(); fd.append("file", file);
    try {
        const res = await fetch(`/api/tracker/projects/${currentProjectId}/ifc`, { method: "POST", body: fd });
        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            alert(`Erreur upload : ${err.detail || res.status}`);
            return;
        }
        await downloadEnrichedIfc();
    } finally {
        btn.disabled = false;
        lbl.textContent = origLbl;
        refreshExportIfcLabel();
    }
});

async function downloadEnrichedIfc() {
    const btn = document.getElementById("exportIfcBtn");
    const lbl = document.getElementById("exportIfcLabel");
    const origLbl = lbl.textContent;
    btn.disabled = true; lbl.textContent = "Génération…";
    try {
        const res = await fetch(`/api/tracker/projects/${currentProjectId}/export-ifc`);
        if (!res.ok) {
            let msg = `HTTP ${res.status}`;
            try { const j = await res.json(); msg = j.detail || msg; } catch {}
            alert(`Erreur export : ${msg}`);
            return;
        }
        // Récupérer le filename depuis Content-Disposition
        const cd = res.headers.get("Content-Disposition") || "";
        const m = cd.match(/filename="?([^"]+)"?/);
        const filename = m ? m[1] : `project_${currentProjectId}.ifc`;
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url; a.download = filename; a.click();
        URL.revokeObjectURL(url);
    } finally {
        btn.disabled = false;
        lbl.textContent = origLbl;
    }
}

function openCsvPicker(event) {
    event.stopPropagation();
    if (!currentProjectId) { alert("Aucun projet sélectionné."); return; }
    document.getElementById("csvPickerMenu")?.remove();

    const btn = document.getElementById("exportReuseCsvBtn");
    const rect = btn.getBoundingClientRect();
    const menu = document.createElement("div");
    menu.id = "csvPickerMenu";
    menu.style.cssText = `position:fixed;top:${rect.bottom + 6}px;left:${rect.left}px;background:white;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.15);z-index:1000;min-width:260px;overflow:hidden;`;
    menu.innerHTML = `
        <button data-kind="pem" style="display:block;width:100%;text-align:left;background:transparent;border:none;padding:.7rem 1rem;font-size:.9rem;cursor:pointer;color:#111827;">
            <strong>📄 Génération PEM</strong><br>
            <span style="font-size:.78rem;color:#6b7280;">Produits / Équipements / Matériaux à réutiliser</span>
        </button>
        <div style="height:1px;background:#e5e7eb;"></div>
        <button data-kind="di" style="display:block;width:100%;text-align:left;background:transparent;border:none;padding:.7rem 1rem;font-size:.9rem;cursor:pointer;color:#111827;">
            <strong>🪨 Génération DI (déchets inertes)</strong><br>
            <span style="font-size:.78rem;color:#6b7280;">Béton, briques, verre, terres… à recycler / réutiliser</span>
        </button>`;
    menu.querySelectorAll("button").forEach(b => {
        b.addEventListener("mouseenter", () => b.style.background = "#f3f4f6");
        b.addEventListener("mouseleave", () => b.style.background = "transparent");
        b.addEventListener("click", () => {
            const kind = b.dataset.kind;
            menu.remove();
            if (kind === "pem") downloadCsv("export-reuse-csv", `diagnostic_reemploi_projet${currentProjectId}.csv`);
            else                downloadCsv("export-di-csv",    `dechets_inertes_projet${currentProjectId}.csv`);
        });
    });
    document.body.appendChild(menu);
    setTimeout(() => {
        document.addEventListener("click", function once() {
            menu.remove();
            document.removeEventListener("click", once);
        });
    }, 0);
}

async function downloadCsv(endpoint, fallbackName) {
    const btn = document.getElementById("exportReuseCsvBtn");
    const orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<i data-lucide="loader-2" style="width:16px;height:16px;"></i> Génération…`;
    if (window.lucide) lucide.createIcons();
    try {
        const res = await fetch(`/api/tracker/projects/${currentProjectId}/${endpoint}`);
        if (!res.ok) {
            let msg = `HTTP ${res.status}`;
            try { const j = await res.json(); msg = j.detail || msg; } catch {}
            alert(`Erreur export CSV : ${msg}`);
            return;
        }
        const cd = res.headers.get("Content-Disposition") || "";
        const m = cd.match(/filename="?([^"]+)"?/);
        const filename = m ? m[1] : fallbackName;
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url; a.download = filename; a.click();
        URL.revokeObjectURL(url);
    } finally {
        btn.disabled = false;
        btn.innerHTML = orig;
        if (window.lucide) lucide.createIcons();
    }
}

async function deleteCurrentProject() {
    if (!currentProjectId) {
        alert("Aucun projet sélectionné.");
        return;
    }
    const sel = document.getElementById("projectSelect");
    const projectLabel = sel.options[sel.selectedIndex]?.text || `Projet #${currentProjectId}`;
    const ok = confirm(
        `⚠️ Supprimer définitivement le projet :\n\n« ${projectLabel} »\n\n` +
        `Tous ses composants ET leur historique de statuts seront effacés.\n` +
        `Cette action est IRRÉVERSIBLE.\n\nContinuer ?`
    );
    if (!ok) return;

    const res = await fetch(`/api/tracker/projects/${currentProjectId}`, { method: "DELETE" });
    if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(`Erreur : ${err.detail || "Suppression échouée"}`);
        return;
    }
    const result = await res.json();
    setCurrentProjectId(null);
    await loadProjects();
    // Sélectionner automatiquement le 1er projet restant (si existe)
    const projSel = document.getElementById("projectSelect");
    if (projSel.options.length && projSel.options[0].value) {
        setCurrentProjectId(projSel.options[0].value);
        projSel.value = String(currentProjectId);
    }
    await loadStats();
    await loadComponents();
    alert(`✅ Projet supprimé — ${result.components_deleted} composant(s) effacé(s).`);
}

function onProjectChange() {
    const sel = document.getElementById("projectSelect");
    setCurrentProjectId(sel.value);
    loadStats();
    loadComponents();
    refreshExportIfcLabel();
}

async function loadStats() {
    if (!currentProjectId) {
        document.getElementById("statsRow").innerHTML =
            '<div class="stat-chip">Aucun projet sélectionné</div>';
        return;
    }
    const res  = await fetch(`/api/tracker/stats?${projectQuery()}`);
    const data = await res.json();
    const row  = document.getElementById("statsRow");
    const statusLabels = { in_building:"In building", démonté:"Démonté", transporté:"Transporté", stocké:"Stocké", réutilisé:"Réutilisé", "à réutiliser":"À réutiliser", "à recycler":"À recycler" };
    let html = `<div class="stat-chip">Total : <span>${data.total}</span></div>`;
    for (const [s, n] of Object.entries(data.by_status || {})) {
        html += `<div class="stat-chip">${statusLabels[s]||s} : <span>${n}</span></div>`;
    }
    row.innerHTML = html;

    const sel = document.getElementById("filterType");
    sel.innerHTML = '<option value="">Tous les types</option>';
    for (const t of Object.keys(data.by_type || {})) {
        sel.innerHTML += `<option value="${t}">${t}</option>`;
    }
}

async function loadComponents() {
    const body = document.getElementById("compBody");
    if (!currentProjectId) {
        body.innerHTML = '<tr><td colspan="6" class="empty-msg">Créez un projet pour commencer.</td></tr>';
        document.getElementById("countLabel").textContent = "";
        return;
    }
    const status = document.getElementById("filterStatus").value;
    const type   = document.getElementById("filterType").value;
    const params = new URLSearchParams({ project_id: currentProjectId });
    if (status) params.set("status", status);
    if (type)   params.set("type", type);

    const res  = await fetch("/api/tracker/components?" + params);
    const data = await res.json();
    document.getElementById("countLabel").textContent = `${data.length} composant(s)`;

    if (!data.length) {
        body.innerHTML = '<tr><td colspan="7" class="empty-msg">Aucun composant trouvé.</td></tr>';
        clearSelection();
        return;
    }
    body.innerHTML = data.map(c => {
        const escId = c.id.replace(/"/g, '&quot;');
        const isSel = selectedIds.has(c.id);
        return `
        <tr data-id="${escId}" class="${isSel?'selected-row':''}" onclick="rowClick(event, '${c.project_id}', '${encodeURIComponent(c.id)}')">
            <td style="text-align:center;" onclick="event.stopPropagation()">
                <input type="checkbox" class="row-chk" data-id="${escId}" ${isSel?'checked':''}
                       onclick="toggleRowCheck(this, event)">
            </td>
            <td style="font-family:monospace;font-size:.78rem;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${c.id}">${c.id}</td>
            <td>${c.type||"—"}</td>
            <td>${c.material||"—"}</td>
            <td>${c.ifc_location||"—"}</td>
            <td><span class="badge badge-${c.status}">${c.status}</span></td>
            <td style="font-size:.78rem;color:#9ca3af;">${(c.updated_at||"").slice(0,16)}</td>
        </tr>`;
    }).join("");
    refreshBulkBar();
}

// ============ SÉLECTION MULTIPLE ============
const selectedIds = new Set();

function rowClick(event, projectId, encodedId) {
    // Si l'utilisateur a cliqué sur la checkbox (déjà géré), on ne navigue pas
    if (event.target.tagName === "INPUT") return;
    window.location = `/tracker/${projectId}/${encodedId}`;
}

function toggleRowCheck(checkbox, event) {
    event.stopPropagation();
    const id = checkbox.dataset.id;
    if (checkbox.checked) selectedIds.add(id);
    else selectedIds.delete(id);
    const tr = checkbox.closest("tr");
    if (tr) tr.classList.toggle("selected-row", checkbox.checked);
    refreshBulkBar();
    syncSelectAllCheckbox();
}

function toggleSelectAll(masterChk) {
    const boxes = document.querySelectorAll(".row-chk");
    boxes.forEach(b => {
        b.checked = masterChk.checked;
        const id = b.dataset.id;
        if (masterChk.checked) selectedIds.add(id);
        else selectedIds.delete(id);
        const tr = b.closest("tr");
        if (tr) tr.classList.toggle("selected-row", masterChk.checked);
    });
    refreshBulkBar();
}

function syncSelectAllCheckbox() {
    const master = document.getElementById("selectAllChk");
    const boxes = document.querySelectorAll(".row-chk");
    if (!boxes.length) { master.checked = false; master.indeterminate = false; return; }
    const checked = [...boxes].filter(b => b.checked).length;
    master.checked = checked === boxes.length;
    master.indeterminate = checked > 0 && checked < boxes.length;
}

function refreshBulkBar() {
    const bar = document.getElementById("bulkBar");
    const count = selectedIds.size;
    document.getElementById("bulkCount").textContent = count;
    bar.style.display = count > 0 ? "flex" : "none";
}

function clearSelection() {
    selectedIds.clear();
    document.querySelectorAll(".row-chk").forEach(b => { b.checked = false; });
    document.querySelectorAll("tr.selected-row").forEach(tr => tr.classList.remove("selected-row"));
    const master = document.getElementById("selectAllChk");
    if (master) { master.checked = false; master.indeterminate = false; }
    refreshBulkBar();
}

// ============ CHANGEMENT DE STATUT EN MASSE ============
const BULK_STATUS_PROMPTS = {
    "transporté":   { title: "Lieu de destination",   question: "Où ces composants ont-ils été transportés ?",  placeholder: "Ex : Entrepôt Nord, Lyon" },
    "stocké":       { title: "Stockage des composants", question: "Précisez la raison et le lieu du stockage.", placeholder: "Ex : Dépôt Paris 13, zone B", withReason: true },
    "à réutiliser": { title: "Lieu de réutilisation",  question: "Où ces composants seront-ils réutilisés ?",    placeholder: "Ex : Chantier École Jules Ferry" },
    "à recycler":   { title: "Lieu de recyclage",     question: "Où ces composants seront-ils recyclés ?",      placeholder: "Ex : Centre de tri SUEZ" },
};
const STORAGE_REASONS = [
    { value: "en attente de réutilisation",      label: "♻️ En attente de réutilisation" },
    { value: "en attente de recyclage",          label: "🔄 En attente de recyclage" },
    { value: "en attente d'évacuation (déchet)", label: "🗑️ En attente d'évacuation (déchet)" },
    { value: "stockage temporaire",              label: "⏳ Stockage temporaire (indéterminé)" },
];

function bulkSetStatus(newStatus) {
    if (selectedIds.size === 0) return;
    const prompt = BULK_STATUS_PROMPTS[newStatus];
    if (!prompt) {
        // Statut sans lieu (in_building, démonté, réutilisé)
        if (!confirm(`Changer le statut de ${selectedIds.size} composant(s) vers « ${newStatus} » ?`)) return;
        submitBulkStatus(newStatus, null);
        return;
    }
    openBulkLocationModal(newStatus, prompt);
}

function openBulkLocationModal(newStatus, prompt) {
    document.getElementById("bulkLocModal")?.remove();
    const reasonHtml = prompt.withReason ? `
        <label style="display:block;font-size:.82rem;color:#374151;font-weight:600;margin:.4rem 0 .3rem;">Raison du stockage</label>
        <select id="bulkReasonInput" style="width:100%;border:1px solid #d1d5db;border-radius:8px;padding:.55rem .8rem;font-size:.92rem;background:white;">
            ${STORAGE_REASONS.map(r => `<option value="${r.value}">${r.label}</option>`).join("")}
        </select>
        <label style="display:block;font-size:.82rem;color:#374151;font-weight:600;margin:.8rem 0 .3rem;">Lieu de stockage</label>
    ` : "";
    const overlay = document.createElement("div");
    overlay.id = "bulkLocModal";
    overlay.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;display:flex;align-items:center;justify-content:center;padding:1rem;";
    overlay.innerHTML = `
        <div onclick="event.stopPropagation()" style="background:white;border-radius:12px;max-width:480px;width:100%;padding:1.4rem 1.6rem;box-shadow:0 10px 30px rgba(0,0,0,.25);">
            <h3 style="margin:0 0 .4rem;font-size:1.1rem;color:#111827;">${prompt.title}</h3>
            <p style="font-size:.88rem;color:#6b7280;margin:0 0 .8rem;">
                ${prompt.question}<br>
                <strong>${selectedIds.size} composant(s)</strong> sélectionné(s) recevront le même statut et la même note.
            </p>
            ${reasonHtml}
            <input type="text" id="bulkLocInput" placeholder="${prompt.placeholder}" autocomplete="off"
                   style="width:100%;border:1px solid #d1d5db;border-radius:8px;padding:.6rem .8rem;font-size:.92rem;">
            <div style="display:flex;justify-content:flex-end;gap:.5rem;margin-top:1rem;">
                <button onclick="document.getElementById('bulkLocModal').remove()" style="background:#f3f4f6;color:#374151;border:none;padding:.55rem 1rem;border-radius:6px;cursor:pointer;font-weight:600;">Annuler</button>
                <button onclick="confirmBulkLocation('${newStatus}', ${!!prompt.withReason})" style="background:#2563eb;color:white;border:none;padding:.55rem 1rem;border-radius:6px;cursor:pointer;font-weight:600;">Valider</button>
            </div>
        </div>`;
    overlay.addEventListener("click", () => overlay.remove());
    document.body.appendChild(overlay);
    const input = document.getElementById("bulkLocInput");
    input.focus();
    input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") confirmBulkLocation(newStatus, !!prompt.withReason);
        if (e.key === "Escape") overlay.remove();
    });
}

function confirmBulkLocation(newStatus, withReason) {
    const lieu = document.getElementById("bulkLocInput").value.trim();
    if (!lieu) {
        document.getElementById("bulkLocInput").style.borderColor = "#dc2626";
        return;
    }
    let note = `Lieu : ${lieu}`;
    if (withReason) {
        const reason = document.getElementById("bulkReasonInput").value;
        note = `${reason} — Lieu : ${lieu}`;
    }
    document.getElementById("bulkLocModal").remove();
    submitBulkStatus(newStatus, note);
}

async function submitBulkStatus(newStatus, note) {
    const ids = [...selectedIds];
    const res = await fetch("/api/tracker/components/bulk-status", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ids, status: newStatus, note }),
    });
    if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(`Erreur : ${err.detail || "mise à jour échouée"}`);
        return;
    }
    const result = await res.json();
    let msg = `✅ ${result.updated} composant(s) mis à jour vers « ${newStatus} ».`;
    if (result.failed) msg += `\n⚠️ ${result.failed} échec(s).`;
    alert(msg);
    clearSelection();
    await loadStats();
    await loadComponents();
}

// ============ BULK META (État & Âge estimé) ============
const BULK_CONDITIONS = ["Neuf", "Bon", "Moyen", "Mauvais"];
const BULK_AGES = [
    "Inférieur à 2 ans",
    "Entre 2 et 10 ans",
    "Entre 10 et 50 ans",
    "Supérieur à 50 ans",
];

function openBulkMetaModal() {
    if (selectedIds.size === 0) return;
    document.getElementById("bulkMetaModal")?.remove();
    const overlay = document.createElement("div");
    overlay.id = "bulkMetaModal";
    overlay.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;display:flex;align-items:center;justify-content:center;padding:1rem;";
    overlay.innerHTML = `
        <div onclick="event.stopPropagation()" style="background:white;border-radius:12px;max-width:520px;width:100%;padding:1.5rem 1.7rem;box-shadow:0 10px 30px rgba(0,0,0,.25);">
            <h3 style="margin:0 0 .4rem;font-size:1.15rem;color:#111827;">📋 État &amp; informations du composant</h3>
            <p style="font-size:.88rem;color:#6b7280;margin:0 0 1rem;">
                <strong>${selectedIds.size} composant(s)</strong> sélectionné(s) recevront ces valeurs.<br>
                Laissez un champ sur « <em>Ne pas modifier</em> » pour ne pas l'écraser.
            </p>

            <label style="display:block;font-size:.82rem;color:#374151;font-weight:600;margin:.4rem 0 .3rem;">
                État de conservation / fonctionnement
            </label>
            <select id="bulkMetaCondition" style="width:100%;border:1px solid #d1d5db;border-radius:8px;padding:.55rem .8rem;font-size:.92rem;background:white;">
                <option value="__none__">— Ne pas modifier —</option>
                ${BULK_CONDITIONS.map(c => `<option value="${c}">${c}</option>`).join("")}
                <option value="">(Effacer la valeur)</option>
            </select>

            <label style="display:block;font-size:.82rem;color:#374151;font-weight:600;margin:.9rem 0 .3rem;">
                Âge estimé
            </label>
            <select id="bulkMetaAge" style="width:100%;border:1px solid #d1d5db;border-radius:8px;padding:.55rem .8rem;font-size:.92rem;background:white;">
                <option value="__none__">— Ne pas modifier —</option>
                ${BULK_AGES.map(a => `<option value="${a}">${a}</option>`).join("")}
                <option value="">(Effacer la valeur)</option>
            </select>

            <div style="display:flex;justify-content:flex-end;gap:.5rem;margin-top:1.2rem;">
                <button onclick="document.getElementById('bulkMetaModal').remove()"
                    style="background:#f3f4f6;color:#374151;border:none;padding:.55rem 1rem;border-radius:6px;cursor:pointer;font-weight:600;">Annuler</button>
                <button onclick="submitBulkMeta()"
                    style="background:#7c3aed;color:white;border:none;padding:.55rem 1rem;border-radius:6px;cursor:pointer;font-weight:600;">Appliquer</button>
            </div>
        </div>`;
    overlay.addEventListener("click", () => overlay.remove());
    document.body.appendChild(overlay);
}

async function submitBulkMeta() {
    const condSel = document.getElementById("bulkMetaCondition").value;
    const ageSel  = document.getElementById("bulkMetaAge").value;
    const payload = { ids: [...selectedIds] };
    if (condSel !== "__none__") payload.condition = condSel; // "" autorisé = effacer
    if (ageSel  !== "__none__") payload.age_estimated = ageSel;
    if (payload.condition === undefined && payload.age_estimated === undefined) {
        alert("Sélectionnez au moins un champ à modifier.");
        return;
    }
    const res = await fetch("/api/tracker/components/bulk-meta", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
    });
    if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(`Erreur : ${err.detail || "mise à jour échouée"}`);
        return;
    }
    const result = await res.json();
    let msg = `✅ ${result.updated} composant(s) mis à jour.`;
    if (result.failed) msg += `\n⚠️ ${result.failed} échec(s).`;
    document.getElementById("bulkMetaModal")?.remove();
    alert(msg);
    clearSelection();
    await loadStats();
    await loadComponents();
}

function openImportModal() {
    document.getElementById("importModal").style.display = "flex";
    document.getElementById("importInfo").textContent = "";
}
function closeImportModal() {
    document.getElementById("importModal").style.display = "none";
}

async function doImport() {
    const raw = document.getElementById("jsonPaste").value.trim();
    const projectName = document.getElementById("projectNameInput").value.trim();
    let components;
    try { components = JSON.parse(raw); } catch(e) {
        document.getElementById("importInfo").textContent = "JSON invalide.";
        return;
    }
    if (!Array.isArray(components)) {
        document.getElementById("importInfo").textContent = "Le JSON doit être un tableau.";
        return;
    }
    const res = await fetch("/api/tracker/import", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ components, project_name: projectName || null }),
    });
    const result = await res.json();
    if (!res.ok) {
        document.getElementById("importInfo").textContent = `Erreur : ${result.detail || "import échoué"}`;
        return;
    }
    document.getElementById("importInfo").textContent =
        `✅ Projet « ${result.project_name} » créé — ${result.created} composant(s).`;
    setCurrentProjectId(result.project_id);
    await loadProjects();
    await loadStats();
    await loadComponents();
    refreshExportIfcLabel();
    setTimeout(closeImportModal, 1500);
}

(async () => {
    await loadProjects();
    await loadStats();
    await loadComponents();
    refreshExportIfcLabel();
})();
</script>
</body>
</html>
