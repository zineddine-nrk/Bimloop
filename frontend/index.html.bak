<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IFC Analyzer — Analyse de Durabilité</title>
    <link rel="stylesheet" href="/static/styles.css?v=15">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    <!-- ============ HEADER ============ -->
    <header class="header">
        <div class="header-content">
            <div class="logo">
                <i data-lucide="building-2"></i>
                <h1>IFC Analyzer</h1>
            </div>
            <div style="display:flex;align-items:center;gap:1.5rem;">
                <p style="margin:0;">Analyse et extraction de données à partir de fichiers IFC.</p>
                <a href="/viewer3d" style="background:#7c3aed;color:white;padding:.4rem 1rem;border-radius:6px;text-decoration:none;font-size:.85rem;font-weight:600;display:flex;align-items:center;gap:.4rem;white-space:nowrap;">
                    <i data-lucide="box" style="width:14px;height:14px;"></i> Viewer 3D
                </a>
                <a href="/tracker" style="background:#2563eb;color:white;padding:.4rem 1rem;border-radius:6px;text-decoration:none;font-size:.85rem;font-weight:600;display:flex;align-items:center;gap:.4rem;white-space:nowrap;">
                    <i data-lucide="map-pin" style="width:14px;height:14px;"></i> Tracker
                </a>
            </div>
        </div>
    </header>

    <main class="container">
        <!-- ============ ZONE D'UPLOAD ============ -->
        <section class="upload-section" id="uploadSection">
            <div class="upload-card">
                <div class="upload-icon">
                    <i data-lucide="upload-cloud"></i>
                </div>
                <h2>Charger un fichier IFC</h2>
                <p>Glissez-déposez votre fichier .ifc ou cliquez pour sélectionner</p>
                <input type="file" id="fileInput" accept=".ifc" hidden>
                <button class="btn btn-primary" id="selectFileBtn">
                    <i data-lucide="file-plus"></i>
                    Sélectionner un fichier
                </button>
                <div id="fileName" class="file-name"></div>
                <button class="btn btn-success" id="analyzeBtn" disabled>
                    <i data-lucide="search"></i>
                    Analyser le fichier
                </button>
            </div>
        </section>

        <!-- ============ LOADER ============ -->
        <div id="loader" class="loader hidden">
            <div class="spinner"></div>
            <p>Analyse en cours...</p>
        </div>

        <!-- ============ MESSAGE DE SUCCÈS ============ -->
        <div id="successMessage" class="alert alert-success hidden"></div>

        <!-- ============ AVERTISSEMENTS ============ -->
        <div id="warnings" class="warnings hidden"></div>

        <!-- ============ RÉSUMÉ GLOBAL ============ -->
        <section id="summarySection" class="summary-section hidden">
            <h2 class="section-title">
                <i data-lucide="bar-chart-3"></i>
                Résumé Global
            </h2>
            <div class="cards-grid" id="summaryCards"></div>
        </section>

        <!-- ============ COMPTAGE PAR TYPE ============ -->
        <section id="typeCountSection" class="type-count-section hidden">
            <h2 class="section-title">
                <i data-lucide="layers"></i>
                Nombre par Type
            </h2>
            <div class="cards-grid" id="typeCountCards"></div>
        </section>

        <!-- ============ FILTRES ============ -->
        <section id="filterSection" class="filter-section hidden">
            <h2 class="section-title">
                <i data-lucide="filter"></i>
                Filtrer les éléments
            </h2>
            <div class="filter-buttons" id="filterButtons"></div>
        </section>

        <!-- ============ TABLEAU DES DONNÉES ============ -->
        <section id="tableSection" class="table-section hidden">
            <div class="table-section-header">
                <h2 class="section-title">
                    <i data-lucide="table"></i>
                    Tableau des Éléments
                </h2>
                <div class="export-buttons">
                    <button class="btn btn-export" id="exportAllPdfBtn">
                        <i data-lucide="download"></i>
                        Exporter tout
                    </button>
                    <button class="btn btn-export" id="exportTypePdfBtn">
                        <i data-lucide="file-down"></i>
                        Exporter sélection
                    </button>
                    <button class="btn btn-export btn-btpmatch" id="exportBtpMatchBtn">
                        <i data-lucide="package-check"></i>
                        Exporter vers BTP Match
                    </button>
                    <button class="btn btn-export btn-json" id="exportJsonBtn">
                        <i data-lucide="braces"></i>
                        Exporter JSON
                    </button>
                    <button class="btn btn-export" id="sendToTrackerBtn"
                        style="background:#7c3aed;color:white;">
                        <i data-lucide="send"></i>
                        Envoyer au Tracker
                    </button>
                    <button class="btn btn-export btn-inertes" id="exportInertesBtn">
                        <i data-lucide="layers"></i>
                        Inertes
                    </button>
                    <button class="btn btn-export btn-equipements" id="exportEquipementsBtn">
                        <i data-lucide="door-open"></i>
                        Équipements
                    </button>
                </div>
            </div>
            <div class="table-wrapper">
                <table id="dataTable">
                    <thead id="tableHead"></thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
            <p id="noResultsMsg" class="no-results hidden">Aucun élément ne correspond au filtre sélectionné.</p>
        </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
        <p>IFC Analyzer — MVP Analyse de Durabilité © 2025</p>
    </footer>

    <!-- Modal BTP Match -->
    <div id="btpMatchModal" class="modal-overlay hidden">
        <div class="modal-box">
            <h3 class="modal-title"><i data-lucide="package-check"></i> Export BTP Match</h3>
            <p class="modal-desc">Choisissez un type d'élément et le format d'export. Les éléments similaires seront regroupés automatiquement.</p>
            <div class="modal-field">
                <label for="btpTypeSelect">Type d'élément</label>
                <select id="btpTypeSelect">
                    <option value="Tous">Tous</option>
                </select>
            </div>
            <div class="modal-field">
                <label>Format</label>
                <div class="modal-radio-group">
                    <label><input type="radio" name="btpFormat" value="csv" checked> CSV (Excel)</label>
                    <label><input type="radio" name="btpFormat" value="pdf"> PDF</label>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" id="btpModalCancelBtn">Annuler</button>
                <button class="btn btn-primary" id="btpModalExportBtn">Exporter</button>
            </div>
        </div>
    </div>

    <script src="/static/script.js?v=17"></script>
</body>
</html>
